<Window x:Class="SteelCoatingTakeoff.App.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projects"
        Height="560" Width="560"
        MinHeight="440" MinWidth="460"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Projects folder" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="FolderBox"
                             ToolTip="Where saved takeoffs live. Leave blank for the per-user default, or point it at a network share for the whole team."/>
                    <Button Grid.Column="2" Content="Use folder" Click="UseFolder_Click" Padding="12,4"/>
                </Grid>
                <TextBlock x:Name="EffectiveFolderText" FontSize="10.5" Foreground="{StaticResource Muted}"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Saved takeoffs" Style="{StaticResource H2}" Margin="2,0,0,6"/>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="ProjectList" BorderThickness="0" Background="Transparent"
                     MouseDoubleClick="Open_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="{Binding MemberCount, Mode=OneWay}"/><Run Text=" members"/>
                                <Run Text="   ·   "/><Run Text="{Binding Modified, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}"/>
                                <Run Text="   ·   "/><Run Text="{Binding EstimateName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="No saved takeoffs in this folder yet."
                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Selected-project actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open" Click="Open_Click" Style="{StaticResource Primary}"
                    Padding="16,5" ToolTip="Open the selected takeoff (replaces the current one)."/>
            <Button Content="Rename" Click="Rename_Click" Margin="8,0,0,0" Padding="12,5"
                    ToolTip="Rename the selected takeoff to the name typed below."/>
            <Button Content="Delete" Click="Delete_Click" Margin="8,0,0,0" Padding="12,5"/>
            <Button Content="New takeoff" Click="New_Click" Margin="8,0,0,0" Padding="12,5"
                    ToolTip="Start a fresh, empty takeoff."/>
        </StackPanel>

        <!-- Save current -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Save current takeoff" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="NameBox"
                             ToolTip="Name for this takeoff. Save writes it to the projects folder; Rename (above) applies this name to the selected takeoff."/>
                    <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource Primary}" Padding="16,5"/>
                    <Button Grid.Column="4" Content="Close" Click="Close_Click" Padding="14,5"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
